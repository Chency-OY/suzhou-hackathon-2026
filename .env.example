# LLM：mock | openai_compat
LLM_PROVIDER=mock
# 以下仅 openai_compat 使用（任意兼容 /chat/completions 的服务）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_THINKING=
LLM_JSON_MODE=true
LLM_TIMEOUT_S=90
# 每日 token 上限，0 表示不限制
DAILY_TOKEN_CAP=0
USAGE_DIR=data/usage
DB_URL=sqlite:///./data/app.db
PROMPTS_DIR=prompts
EMBED_PROVIDER=hash
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
VECTOR_STORE=chroma
CHROMA_DIR=data/chroma
