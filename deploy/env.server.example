# 服务器本地 .env 模板（不含任何真实密钥）
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=REPLACE_WITH_NAME_FROM_ollama_list
LLM_JSON_MODE=true
LLM_TIMEOUT_S=180
DAILY_TOKEN_CAP=0
USAGE_DIR=data/usage
DB_URL=sqlite:///./data/app.db
PROMPTS_DIR=prompts
EMBED_PROVIDER=hash
VECTOR_STORE=chroma
CHROMA_DIR=data/chroma
FRONTEND_DIST=frontend/dist
